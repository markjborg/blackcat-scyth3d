# Copy to .env and replace the key. Never commit .env.
# Generate a key with: openssl rand -hex 32
SCYTH3D_API_KEY=replace-with-a-long-random-string

# Optional
# PORT=8080
# SCYTH3D_DATA_DIR=/data
# SCYTH3D_MAX_UPLOAD_MB=100
# SCYTH3D_JOB_TTL_HOURS=48
# SCYTH3D_MAX_CONCURRENT_SLICES=1
# SCYTH3D_SLICE_TIMEOUT_SEC=900
# SCYTH3D_ALLOWED_HOSTS=localhost,127.0.0.1
